# Credenciales de Supabase. Copiar a .env y rellenar.
#
# ⚠️ La clave ANON es publica por diseno: no da acceso a nada sin pasar por RLS. Aun asi va en
# .env para no fijarla en el repo publico.
#
# ⛔ La clave SERVICE_ROLE NO va aqui nunca. Esa solo vive en los secretos de las Edge
# Functions de Supabase, porque salta la seguridad de filas entera.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
