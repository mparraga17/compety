{
  "expo": {
    "name": "Compety",
    "slug": "compety",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "owner": "pizcodeploy",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pizcodeploy.compety",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "package": "com.pizcodeploy.compety",
      "adaptiveIcon": {
        "backgroundColor": "#14151a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Compety lee tus entrenos y tu frecuencia cardiaca para calcular la carga de cada sesion y tu puntuacion en las ligas con tus amigos. El calculo se hace en tu iPhone: al servidor solo viaja la puntuacion.",
          "NSHealthUpdateUsageDescription": false,
          "background": true
        }
      ],
      "expo-localization",
      "expo-background-task"
    ],
    "extra": {
      "eas": {
        "projectId": "b091cdfe-41d8-4f01-8999-a2ff2fc8e002"
      }
    }
  }
}
